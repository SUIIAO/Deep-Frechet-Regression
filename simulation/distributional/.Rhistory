)
xout = data.frame(X1 = runif(nOut, -1, 0), X2 = runif(nOut, 0, 1), X3 = runif(nOut, 1, 2),
X4 = rnorm(nOut, 0, 1), X5 = rnorm(nOut, -10, 3), X6 = rnorm(nOut, 10, 3),
X7 = sample(c(0,1),nOut,TRUE,c(0.4,0.6)),
X8 = sample(c(0,1),nOut,TRUE,c(0.3,0.7)),
X9 = sample(c(0,1),nOut,TRUE,c(0.6,0.3))
)
# Generate response data
y = list()
yMean <- matrix(nrow = n, ncol = N-1)
mu.sd = NULL
for(i in 1:n) {
# Generate expected mean and standard deviation
expect_eta_Z = 3 * (sin(pi * x[i,1])+cos(pi * x[i,2])) * x[i,8] +
(5*x[i,4]^2 + x[i,5]) * x[i,7]
expect_sigma_Z = sigma0 + 0.5*(sin(pi * x[i,1])+cos(pi * x[i,2])) * x[i,8] +
abs(5*x[i,4]^2 + x[i,5]) * x[i,7]
# Sample mean and standard deviation
mu = rnorm(1, mean = expect_eta_Z, sd = 1)
sigma = rgamma(1, shape = expect_sigma_Z^2/kappa, scale = kappa/expect_sigma_Z)
# Generate response and true quantile values
y[[i]] = sort(mu + sigma * rnorm(N)) # rnorm(N, mean = mu, sd = sigma)
yMean[i, ] = expect_eta_Z + expect_sigma_Z * qnorm(c(1:(N-1))/N)
mu.sd = rbind(mu.sd, data.frame(mu, sigma))
}
y_mat = do.call(rbind, y)
dist.den = as.matrix(dist(y_mat, upper = T, diag = T))/sqrt(N)
x_eps_isomap = as.data.frame(vegan::isomap(dist.den, k=50, ndim = 2)$points)
x_eps_isomap$Dim1 = scale(x_eps_isomap$Dim1)[,1]
x_eps_isomap$Dim2 = scale(x_eps_isomap$Dim2)[,1]
x_isomap = as.data.frame(vegan::isomap(dist.den, k=50, ndim = 2)$points)
x_isomap$Dim1 = scale(x_isomap$Dim1)[,1]
x_isomap$Dim2 = scale(x_isomap$Dim2)[,1]
x_isomap %>%
# mutate(mu = apply(x, 1, function(xx){mu0 + (xx[4]^2*5 + xx[5]) * xx[7] + alpha * (sin(pi * xx[1])+cos(pi * xx[2])) * xx[8]}),
#        sd = apply(x, 1, function(xx){sigma0 + beta * (sin(pi * xx[1])+cos(pi * xx[2])) * xx[8] + abs(xx[4]^2*5 + xx[5]) * xx[7]})) %>%
cbind(mu.sd) %>%
mutate(mu = scale(mu),
sigma = -scale(sigma)) %>%
ggplot() +
geom_point(aes(x = Dim1, y = Dim2, color = "ISOMAP")) +
geom_point(aes(x = mu, y = sigma, color = "True parameters")) +
labs(x = "Dim1 / mu", y = "Dim2 / sigma", color = "") +
theme_bw() +
theme(text = element_text(size=20),
# axis.text.x = element_text(angle = 90),
plot.title = element_text(hjust = 0.5),
legend.position = "top")
