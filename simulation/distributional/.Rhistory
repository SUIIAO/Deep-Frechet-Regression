width = 10, height = 8)
plot.data %>%
ggplot() +
geom_tile(aes(x=as.factor(Var1), y=as.factor(Var2),
fill=value^1.5)) +
geom_text(data = plot.data %>%
group_by(method, quantile) %>%
dplyr::summarise(total = total[1]),
aes(label = sprintf("%s", format(total, big.mark = ","))),
x = Inf, y = Inf,
vjust = 1, hjust = 1, size = 5) +
# scale_fill_distiller(palette = "YlOrRd", direction = 1) +
scale_fill_distiller(breaks = c(0,10000,20000,30000)^(1.5),
labels = c(0,10000,20000,30000),
palette = 'YlOrRd',
direction = 1
) +
labs(x = "Region", y = "Region", fill = "ridership") +
facet_grid(row = vars(factor(method, levels = c("Mon - Thu", "Fri, Sat", "Sun, Holiday"))),
col = vars(quantile)) +
theme(aspect.ratio = 1, text = element_text(size=20),
axis.text.x = element_text(angle = 90))
dev.off()
